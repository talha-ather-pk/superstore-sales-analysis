table dim_geography
	lineageTag: 91ad019a-6c52-5eb8-80c1-27500f8445d4

	column geo_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6d68a474-edc6-5ed3-a45f-f9b16f31f7d5
		summarizeBy: none
		sourceColumn: geo_key

		annotation SummarizationSetBy = Automatic

	column province
