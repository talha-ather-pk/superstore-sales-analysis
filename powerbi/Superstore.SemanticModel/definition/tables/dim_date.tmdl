		sourceColumn: weekday

		annotation SummarizationSetBy = Automatic

	column is_weekend
		dataType: boolean
		lineageTag: d70ceb6a-1dc1-55c4-b799-7a71df7d0771
		summarizeBy: none
		sourceColumn: is_weekend

		annotation SummarizationSetBy = Automatic

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"year", Int64.Type}, {"quarter", type text}, {"month_num", Int64.Type}, {"month", type text}, {"year_month", type text}, {"weekday", type text}}, "en-US"),
				    Logicals = Table.TransformColumns(Typed, {{"is_weekend", each _ = "True", type logical}})
				in
				    Logicals

	annotation PBI_ResultType = Table
