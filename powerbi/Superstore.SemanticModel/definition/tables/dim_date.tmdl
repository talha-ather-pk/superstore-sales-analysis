		formatString: Short Date
		isKey
		lineageTag: a5e74d89-3815-5bdf-9369-ee7637de2775
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 79d74e36-964e-545d-9e6f-1e0f15430239
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column quarter
		dataType: string
		lineageTag: 0f165e52-c62b-53ec-af40-6df4b6940252
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	column month_num
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 36a53c50-a45c-5f16-b660-593477964443
		summarizeBy: none
		sourceColumn: month_num

		annotation SummarizationSetBy = Automatic

	column month
		dataType: string
		sortByColumn: month_num
		lineageTag: b35322b7-79c1-5882-9562-ca7fa84b20b4
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	column year_month
		dataType: string
		lineageTag: d04f3cc9-38d9-5e4e-91f6-b32031f70bd0
		summarizeBy: none
