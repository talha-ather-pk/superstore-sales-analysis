	column 'Discount Band' = SWITCH ( TRUE (), fact_sales[discount] <= 0.03, "0-3%", fact_sales[discount] <= 0.06, "4-6%", fact_sales[discount] <= 0.09, "7-9%", "10%+" )
		dataType: string
		sortByColumn: 'Discount Band Order'
		lineageTag: afab083e-5455-5d35-8a08-6bf7e33cb90c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Discount Band Order' = SWITCH ( TRUE (), fact_sales[discount] <= 0.03, 1, fact_sales[discount] <= 0.06, 2, fact_sales[discount] <= 0.09, 3, 4 )
		dataType: int64
		isHidden
		lineageTag: 67a87a9d-3a57-5e38-a824-2d3bfe4e558f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_sales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"row_id", Int64.Type}, {"order_id", Int64.Type}, {"order_date", type date}, {"ship_date", type date}, {"customer_key", Int64.Type}, {"product_key", Int64.Type}, {"geo_key", Int64.Type}, {"customer_segment", type text}, {"order_priority", type text}, {"ship_mode", type text}, {"order_quantity", Int64.Type}, {"unit_price", type number}, {"discount", type number}, {"sales", type number}, {"profit", type number}, {"shipping_cost", type number}, {"days_to_ship", Int64.Type}}, "en-US"),
				    Logicals = Table.TransformColumns(Typed, {{"is_loss", each _ = "True", type logical}, {"is_large_order", each _ = "True", type logical}})
				in
				    Logicals

	annotation PBI_ResultType = Table
