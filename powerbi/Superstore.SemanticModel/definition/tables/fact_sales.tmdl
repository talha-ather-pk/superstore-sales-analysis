table fact_sales
	lineageTag: a131a322-daa3-5dff-9cc0-66682d027add

	measure 'Total Sales' = SUM ( fact_sales[sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Core KPIs
		lineageTag: 7c8ad7f3-c501-5bd1-a797-8b3b49a892fd

	measure 'Total Profit' = SUM ( fact_sales[profit] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Core KPIs
		lineageTag: 1e5a40bb-319c-5a82-ab0d-18a3f9e64b85

	measure 'Profit Margin %' = DIVIDE ( [Total Profit], [Total Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Core KPIs
		lineageTag: d8b84f7a-9698-50e2-8839-264c64867b52

	measure Orders = DISTINCTCOUNT ( fact_sales[order_id] )
		formatString: #,0
		displayFolder: Core KPIs
		lineageTag: 0426d3fa-e88a-52c6-a862-9bb32eb1b1be

	measure 'Units Sold' = SUM ( fact_sales[order_quantity] )
		formatString: #,0
		displayFolder: Core KPIs
		lineageTag: 02dadff1-b510-5027-902b-f4294c907820

	measure 'Avg Order Value' = DIVIDE ( [Total Sales], [Orders] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Core KPIs
		lineageTag: 7ed2e7ab-dbd7-558a-882b-dfbf93a754ea

	measure Customers = DISTINCTCOUNT ( fact_sales[customer_key] )
		formatString: #,0
		displayFolder: Core KPIs
		lineageTag: bceaa540-fa32-5cd7-b6d9-de9dbc21b23a

	measure 'Avg Discount %' = AVERAGE ( fact_sales[discount] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Core KPIs
		lineageTag: 8f2cd62c-88f2-55a7-a4b0-e861fdcee207

	measure 'Shipping Cost' = SUM ( fact_sales[shipping_cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Core KPIs
		lineageTag: cee70f02-68c7-5609-97ae-aa3ce4a128d8

	measure 'Avg Days to Ship' = AVERAGE ( fact_sales[days_to_ship] )
		formatString: #,0.0
		displayFolder: Core KPIs
		lineageTag: bc1e8319-d0d4-5d4f-8c1a-abfac3f66367

	measure 'Sales PY' = CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time intelligence
		lineageTag: 0eee9ff5-0434-5592-8fd4-0e8f4878eed2

	measure 'Sales YoY %' = DIVIDE ( [Total Sales] - [Sales PY], [Sales PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Time intelligence
		lineageTag: c76b878c-ad6a-590a-bc04-532528b772b2

	measure 'Profit PY' = CALCULATE ( [Total Profit], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time intelligence
		lineageTag: d9ca73f0-03eb-5ed8-b83a-3180f9905601

	measure 'Profit YoY %' = DIVIDE ( [Total Profit] - [Profit PY], [Profit PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Time intelligence
		lineageTag: d9f057b0-3378-5a70-ae93-9465792d2298

	measure 'Sales YTD' = TOTALYTD ( [Total Sales], dim_date[date] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time intelligence
		lineageTag: 80fa9891-e57d-5f68-b0a8-c772f0e49206

	measure 'Sales Rolling 3M' = CALCULATE ( [Total Sales], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time intelligence
		lineageTag: 5b833340-88c3-5e04-842f-9081f2ec2727

	measure 'Loss Lines' = CALCULATE ( COUNTROWS ( fact_sales ), fact_sales[is_loss] = TRUE () )
		formatString: #,0
		displayFolder: Profitability
		lineageTag: ac00dc07-3b0d-5e59-80a7-3668bd800fea

	measure 'Loss Lines %' = DIVIDE ( [Loss Lines], COUNTROWS ( fact_sales ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Profitability
		lineageTag: 390689fa-9de7-520e-9082-a961e1ea6ef3

	measure 'Loss Amount' = CALCULATE ( [Total Profit], fact_sales[is_loss] = TRUE () )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Profitability
		lineageTag: 92272e70-6c7c-5d98-a316-a26177e835db

	measure 'Profit Rank (Sub-Category)' = RANKX ( ALL ( dim_product[product_sub_category] ), [Total Profit], , DESC )
		formatString: #,0
		displayFolder: Profitability
		lineageTag: 3844f9af-a99e-5f38-b2a8-ebd2829b11f5

	measure 'Top 20% Customer Sales Share' = VAR CustomerCount = COUNTROWS ( ALL ( dim_customer ) ) VAR TopCustomers = TOPN ( ROUND ( CustomerCount * 0.2, 0 ), ALL ( dim_customer ), [Total Sales], DESC ) RETURN DIVIDE ( CALCULATE ( [Total Sales], TopCustomers ), CALCULATE ( [Total Sales], ALL ( dim_customer ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Customers
		lineageTag: 83a1875a-9966-503e-919a-63b0106771c9

	measure 'Margin Color' = SWITCH ( TRUE (), [Profit Margin %] < 0, "#C0392B", [Profit Margin %] < 0.08, "#E67E22", "#2563EB" )
		displayFolder: Formatting
		lineageTag: 14fa92fb-7183-562f-9b80-833077312c08

