table dim_customer
	lineageTag: 54884e43-0eff-5418-ae98-e293ad7e72b5

	column customer_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8ce77d49-d9cf-5b18-8b97-40a1ed4fe2c1
		summarizeBy: none
		sourceColumn: customer_key

		annotation SummarizationSetBy = Automatic

	column customer_name
		dataType: string
		lineageTag: 82571aab-7ef5-5e85-80c6-209905eb8c7c
		summarizeBy: none
		sourceColumn: customer_name

		annotation SummarizationSetBy = Automatic

	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"customer_key", Int64.Type}, {"customer_name", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
